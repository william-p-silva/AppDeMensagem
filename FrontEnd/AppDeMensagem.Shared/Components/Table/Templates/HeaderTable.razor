

<div class="flex items-center gap-3 bg-zinc-800 px-4 py-5 text-2xl text-zinc-100 @ClassName">
	<DynamicComponent Type="@HeaderProps.Icon" Parameters="@ParametrosIcone" />
	<h2 class="font-bold tracking-wide text-zinc-100">@HeaderProps.Title</h2>
</div>



@code {
	[Parameter, EditorRequired]
	public TableHeaderProps HeaderProps { get; set; }

	[Parameter] public string ClassName { get; set; } = string.Empty;

	public sealed record TableHeaderProps(
		string Title,
		Type Icon,
		int IconStroke,
		int IconSize = 20
	);

	private IDictionary<string, object> ParametrosIcone => new Dictionary<string, object>
	{
		{ "Size", HeaderProps.IconSize },
		{ "Stroke", HeaderProps.IconStroke }
	};
}