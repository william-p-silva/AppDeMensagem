@using Feature.Admin.Services.Dashboard
@using AppDeMensagem.Feature.Admin.Models.User
@inject DashboardService DashboardService

<div class="w-full rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl">

	<!-- Cabeçalho do Card -->
	<div class="mb-6 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<h2 class="text-2xl font-extrabold text-zinc-800">Gerenciamento de Usuários 👥</h2>
			<p class="text-sm text-zinc-500">Lista completa de usuários cadastrados na plataforma.</p>
		</div>
		<button @onclick="CarregarDados"
				class="mt-2 inline-flex items-center justify-center gap-2 rounded-xl bg-blue-500 px-4 py-2 text-sm font-bold text-white shadow-md transition-all hover:bg-blue-600 active:scale-95 sm:mt-0">
			<span>🔄</span> Atualizar
		</button>
	</div>

	<!-- Alerta de Erro -->
	@if (DashboardService.ErrorDashboard?.Count > 0)
	{
		<div class="mb-4 flex flex-col gap-1 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-600">
			@foreach (var erro in DashboardService.ErrorDashboard)
			{
				<p>⚠️ @erro</p>
			}
		</div>
	}

	<!-- Tabela Responsiva -->
	<div class="overflow-x-auto rounded-xl border border-zinc-200">
		<table class="w-full text-left text-sm text-zinc-600">
			<!-- Header da Tabela -->
			<thead class="border-b border-zinc-200 bg-zinc-100 text-xs font-extrabold text-zinc-700 uppercase">
				<tr>
					<th scope="col" class="px-6 py-4">ID</th>
					<th scope="col" class="px-6 py-4">Usuário</th>
					<th scope="col" class="px-6 py-4">E-mail</th>
					<th scope="col" class="px-6 py-4">Perfil</th>
				</tr>
			</thead>

			<!-- Corpo da Tabela -->
			<tbody class="divide-y divide-zinc-200 bg-white">
				@if (DashboardService.IsLoading)
				{
					<!-- Skeleton Loaders durante o carregamento -->
					@for (int i = 0; i < 4; i++)
					{
						<tr class="animate-pulse">
							<td class="px-6 py-4"><div class="h-4 w-20 rounded bg-zinc-200"></div></td>
							<td class="px-6 py-4"><div class="h-4 w-32 rounded bg-zinc-200"></div></td>
							<td class="px-6 py-4"><div class="h-4 w-40 rounded bg-zinc-200"></div></td>
							<td class="px-6 py-4"><div class="h-6 w-16 rounded-lg bg-zinc-200"></div></td>
						</tr>
					}
				}
				else if (DashboardService.Users is null || !DashboardService.Users.Any())
				{
					<tr>
						<td colspan="4" class="px-6 py-8 text-center text-zinc-400">
							<span class="mb-2 block text-3xl">🔍</span>
							Nenhum usuário encontrado.
						</td>
					</tr>
				}
				else
				{
					@if (DashboardService.Users is not null)
					{
						@foreach (var user in DashboardService.Users)
						{
							<tr class="transition-colors hover:bg-zinc-50">
								<!-- ID reduzido para exibição de GUID -->
								<td class="px-6 py-4 font-mono text-xs text-zinc-400" title="@user.User_ID">
									@user.User_ID.ToString()
								</td>
								<!-- Nome com Avatar -->
								<td class="flex items-center gap-3 px-6 py-4 font-bold text-zinc-800">
									<div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100 text-xs font-extrabold text-blue-600 shadow-sm">
										@(string.IsNullOrEmpty(user.Name) ? "U" : user.Name[0].ToString().ToUpper())
									</div>
									@user.Name
								</td>
								<!-- Email -->
								<td class="px-6 py-4 text-zinc-600">
									@user.Email
								</td>
								<!-- Badge de Perfil -->
								<td class="px-6 py-4">
									@if (string.Equals(user.Profile, "Admin", StringComparison.OrdinalIgnoreCase))
									{
										<span class="inline-flex items-center gap-1 rounded-lg border border-purple-200 bg-purple-100 px-2.5 py-1 text-xs font-bold text-purple-700">
											👑 Admin
										</span>
									}
									else
									{
										<span class="inline-flex items-center gap-1 rounded-lg border border-blue-200 bg-blue-100 px-2.5 py-1 text-xs font-bold text-blue-700">
											💬 Usuário
										</span>
									}
								</td>
							</tr>
						}
					}
					
				}
			</tbody>

			<!-- Rodapé da Tabela -->
			<tfoot class="border-t border-zinc-200 bg-zinc-50">
				<tr>
					<td colspan="4" class="px-6 py-3 text-xs font-semibold text-zinc-500">
						Total de registros: <span class="font-bold text-zinc-800">@(DashboardService.Users?.Count ?? 0)</span>
					</td>
				</tr>
			</tfoot>
		</table>
	</div>
</div>

@code {
	protected async override Task OnInitializedAsync()
	{
		await CarregarDados();
	}

	private async Task CarregarDados()
	{
		await DashboardService.GetAllUsers();
	}
}