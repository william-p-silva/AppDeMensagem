@using Feature.User.Services.Chat
@inject ChatService ChatService
@implements IDisposable

<header class="bg-gradient-to-l w-full border-b border-blue-950/30 from-blue-800 to-blue-700 px-4 py-2">
	<div class="flex items-center justify-between">
		<div class="flex items-center justify-center gap-6">

			<div class="flex h-12 w-12 flex-none scale-105 items-center justify-center rounded-full bg-white text-3xl font-bold text-blue-900 shadow-inner transition-all duration-300 ease-in-out">
				@(string.IsNullOrWhiteSpace(ChatService.ChatHistory.NameChat) ? "U" : ChatService.ChatHistory.NameChat[0].ToString().ToUpper())
			</div>

			<div class="h-full flex-col gap-6">
				<h1 class="text-2xl font-extrabold">@(string.IsNullOrWhiteSpace(ChatService.ChatHistory.NameChat) ? "User" : ChatService.ChatHistory.NameChat)</h1>
				<p class="text-sm font-bold text-gray-500">Online</p>
			</div>
		</div>
		<div class="flex gap-12">
			<div>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
					<path d="m21 21-4.34-4.34" />
					<circle cx="11" cy="11" r="8" />
				</svg>
			</div>
			<div>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis-vertical-icon lucide-ellipsis-vertical">
					<circle cx="12" cy="12" r="1" />
					<circle cx="12" cy="5" r="1" />
					<circle cx="12" cy="19" r="1" />
				</svg>
			</div>
		</div>

	</div>
</header>

@code {

	protected override void OnInitialized()
	{
		ChatService.OnChange += StateHasChanged;
	}

	public void Dispose()
	{
		ChatService.OnChange -= StateHasChanged;
	}
}