@using AppDeMensagem.Feature.User.Components.Chat.Menu
@using AppDeMensagem.Feature.User.Components.Chat.Models
@using Feature.User.Services.Chat
@inject ChatService ChatService
@implements IDisposable

<header class="w-full border-b border-blue-950/30 bg-linear-to-l from-blue-800 to-blue-700 px-4 py-2">
	<div class="flex items-center justify-between">
		<div class="flex items-center justify-center gap-6">

			<div class="flex size-12 flex-none scale-105 items-center justify-center rounded-full bg-white text-3xl font-bold text-blue-900 shadow-inner transition-all duration-300 ease-in-out">
				@(string.IsNullOrWhiteSpace(ChatService.ChatHistory.NameChat) ? "U" : ChatService.ChatHistory.NameChat[0].ToString().ToUpper())
			</div>

			<div class="h-full flex-col gap-6">
				<h1 class="text-2xl font-extrabold">@(string.IsNullOrWhiteSpace(ChatService.ChatHistory.NameChat) ? "User" : ChatService.ChatHistory.NameChat)</h1>
				<p class="text-sm font-bold text-gray-500">Online</p>
			</div>
		</div>
		<div class="flex gap-12">
			<div>
				<IconLupa Size="24" />
			</div>
			<div class="relative">
				<span @onclick="ToggleMenu" class="cursor-pointer">
					<IconPontos Size="24" />
				</span>

				@if (OpenMenu)
				{
					<OpcoesChat Opcoes="@Opcoes" />
				}

			</div>
		</div>

	</div>
</header>

@code {

	private List<OpcoesChatProps> Opcoes = new List<OpcoesChatProps>();

	private bool OpenMenu { get; set; } = false;

	private void ToggleMenu()
	{
		OpenMenu = !OpenMenu;
	}

	private async Task DeletarChat()
	{
		await ChatService.DeleteChat();
	}

	protected override void OnInitialized()
	{
		Opcoes =
		[
			new OpcoesChatProps(
				Text: "Deletar",
				OnClick: EventCallback.Factory.Create(this, DeletarChat),
				Icone: typeof(IconLixeira),
				IconSize: 20,
				IconStroke: 2
			),
			new OpcoesChatProps(
				Text: "Sair",
				OnClick: EventCallback.Factory.Create(this, DeletarChat),
				Icone: typeof(IconPerfil),
				IconSize: 20,
				IconStroke: 2
			)
		];

		OpenMenu = false;

		ChatService.OnChange += StateHasChanged;
	}

	public void Dispose()
	{
		ChatService.OnChange -= StateHasChanged;
	}
}