@using Feature.User.Services.Chat
@inject ChatService ChatService
@implements IDisposable

<header class="w-full bg-black px-4 py-2">
	<div class="flex items-center justify-between">
		<div class="flex items-center justify-center gap-6">

			<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-4xl font-bold text-black">
				@(string.IsNullOrWhiteSpace(ChatService.ChatHistory.NameChat) ? "U" : ChatService.ChatHistory.NameChat[0].ToString().ToUpper())
			</div>

			<div class="h-full flex-col gap-6">
				<h1 class="text-2xl font-extrabold">@(string.IsNullOrWhiteSpace(ChatService.ChatHistory.NameChat) ? "User" : ChatService.ChatHistory.NameChat)</h1>
				<p class="text-sm font-bold text-gray-500">Online</p>
			</div>
		</div>
		<div class="flex gap-12">
			<div>
				Lupa
			</div>
			<div>
				:
			</div>
		</div>

	</div>
</header>

@code{
	
	protected override void OnInitialized()
	{
		ChatService.OnChange += StateHasChanged;
	}

	public void Dispose()
	{
		ChatService.OnChange -= StateHasChanged;
	}
}