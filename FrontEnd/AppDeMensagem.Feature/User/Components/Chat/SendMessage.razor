@using Feature.User.Services.Chat
@inject ChatService ChatService
@implements IDisposable


<section class="px-6">
	<EditForm Model="ChatService.RequestSendMessage" OnValidSubmit="HandleSubmit">
		<DataAnnotationsValidator />

		<div class="flex w-full items-center justify-between rounded-full border border-white/30 bg-white/30 p-2 px-4 text-white">
			<h1>
				<IconPlus Size="24" />
			</h1>
			<p>
				<IconEmojiPlus Size="24" />
			</p>

			<input type="text" @bind="ChatService.RequestSendMessage.TextMessage"
				   @bind:event="oninput"
				   class="align-center max-h-8 w-[80%] border-none fill-white p-1 outline-none"
				   placeholder="Digite sua mensagem...">
		</input>

		<ValidationMessage For="@(() => ChatService.RequestSendMessage.TextMessage)" />

		@if (string.IsNullOrEmpty(ChatService.RequestSendMessage.TextMessage))
		{
			<p class="rounded-full bg-blue-500 px-4 py-2 text-white">				
				<IconMicrofone Size="24" />
			</p>
		}
		else
		{
			<button type="submit" class="cursor-pointer rounded-full bg-blue-500 px-4 py-2 text-white">
				<IconEnviar Size="24" Stroke="2" />
			</button>
		}
	</div>
</EditForm>

</section>

@code {

	protected override async Task OnInitializedAsync()
	{
		ChatService.OnChange += StateHasChanged;
	}

	private async Task HandleSubmit()
	{
		await ChatService.SendMessage();
	}

	public void Dispose()
	{
		ChatService.OnChange -= StateHasChanged;
	}
}
