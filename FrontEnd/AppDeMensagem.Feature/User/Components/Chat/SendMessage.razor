@using Feature.User.Services.Chat
@inject ChatService ChatService
@implements IDisposable


<section class="px-6">
	<EditForm Model="ChatService.RequestSendMessage" OnValidSubmit="HandleSubmit">
		<DataAnnotationsValidator />

		<div class="flex w-full items-center justify-between rounded-full bg-white p-2 text-black">
			<h1>Lupa</h1>
			<p>Emojis</p>

			<input type="text" @bind="ChatService.RequestSendMessage.TextMessage"
					  @bind:event="oninput"
					  class="align-center max-h-8 w-[80%] border-none p-1 outline-none"
					  placeholder="Digite sua mensagem...">
			</input>

			<ValidationMessage For="@(() => ChatService.RequestSendMessage.TextMessage)" />

			@if (string.IsNullOrEmpty(ChatService.RequestSendMessage.TextMessage))
			{
				<p class="rounded-full bg-blue-500 px-4 py-2 text-white">Mic</p>
			}
			else
			{
				<button type="submit" class="rounded-full bg-blue-500 px-4 py-2 text-white">
					Enviar
				</button>
			}
		</div>
	</EditForm>

</section>

@code{

	protected override async Task OnInitializedAsync()
	{
		ChatService.OnChange += StateHasChanged;
	}

	private async Task HandleSubmit()
	{
		await ChatService.SendMessage();
	}

	public void Dispose()
	{
		ChatService.OnChange -= StateHasChanged;
	}
}
