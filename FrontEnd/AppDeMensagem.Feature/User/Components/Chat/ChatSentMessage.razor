@using AppDeMensagem.Feature.User.Model.Chat


<div class="flex justify-end">
	<div class="mt-1 mb-2 max-w-[70%] rounded-l-lg rounded-b-lg bg-blue-500 px-4 text-sm text-white">
		<div class="py-1 font-bold">
			<p>@Message.Sender.Name</p>
		</div>
		<div class="pb-2">
			<p>@Message.TextMessage</p>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public MessageChatModel Message { get; set; } = new MessageChatModel();
}
