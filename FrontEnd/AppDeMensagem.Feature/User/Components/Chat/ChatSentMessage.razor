@using AppDeMensagem.Feature.User.Model.Chat


<div class="flex justify-end">
	<div class="mt-1 mb-2 max-w-[70%] rounded-xl rounded-br-none border border-white/20 bg-blue-400/30 px-3 py-2 text-sm text-white shadow">
		<div class="">
			<p class="leading-relaxed break-words">@Message.TextMessage</p>
		</div>
		<div class="flex justify-end pt-1 text-[10px] text-white/70">
			<p>@Message.SendTime.ToLocalTime().ToString("HH:mm")</p>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public MessageChatModel Message { get; set; } = new MessageChatModel();
}
