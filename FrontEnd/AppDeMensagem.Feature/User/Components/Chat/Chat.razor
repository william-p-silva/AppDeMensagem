@using Feature.User.Services.Chat
@inject ChatService ChatService
@implements IDisposable


<section class="h-full w-full overflow-hidden bg-amber-500">
	<HeaderChat />
	<BodyChat />
	<SendMessage />
</section>


@code {
	public void Dispose()
	{
		ChatService.OnChange -= StateHasChanged;
	}

	protected override async Task OnInitializedAsync() => ChatService.OnChange += StateHasChanged;
}