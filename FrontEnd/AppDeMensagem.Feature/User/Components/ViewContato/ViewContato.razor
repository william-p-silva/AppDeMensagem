@using Feature.User.Services.ViewContato
@inject ViewContatoService ViewContatoService
@inject Authentication Authentication


<section class="bg-gradient-to-l h-full w-[25vw] border-r border-r-blue-800/20 from-blue-700 to-blue-950/80 p-4">
	<article class="flex h-full w-full flex-col gap-6">

		<HeaderViewContato />

		<section class="-ml-4 h-full scrollbar-none overflow-y-auto">
			@if (ViewContatoService.IsLoading)
			{
				<div>
					Carregando ...
				</div>
			}
			else
			{
				@if (ViewContatoService.Chats.Count > 0)
				{
					@foreach (var chat in ViewContatoService.Chats)
					{
						<CardContato Chat="@chat" />
					}
				}
				else
				{
					<div>
						<!--Sem contatos-->
					</div>
				}
			}
		</section>
		@if (ViewContatoService.ErrorChats.Count > 0)
		{
			<div>
				@foreach (string error in ViewContatoService.ErrorChats)
				{
					<p>@error</p>
				}
			</div>
		}
		<footer>
			<!--Infos finais-->
		</footer>
	</article>
</section>

<ModalCreateChatPrivate />

@code {

	protected override async Task OnInitializedAsync()
	{
		await LoadChats();
	}

	private async Task LoadChats()
	{
		await ViewContatoService.SetChats();
	}
}
