@using Feature.User.Services.ViewContato
@inject HeaderViewContatoService HeaderService

<header class="flex flex-col gap-6">
	<div class="flex justify-between">
		<h1 class="text-3xl font-bold">Conversas</h1>
		<div class="flex gap-6">
			<button type="button" class="cursor-pointer"
					@onclick="OpenModal">
				<IconNewChat Size="24" />
			</button>
			<div>
				<IconPontos Size="24" />
			</div>
		</div>
	</div>

	<EditForm Model="SearchChat" class="flex w-full items-center justify-center rounded-full border border-white/30 bg-white/30 p-1 outline-none">
		<p class="text-white/60">
			<IconLupa Size="24" />
		</p>
		<InputText @bind-Value="SearchChat"
				   class="w-full rounded-full px-2 py-1 outline-none"
				   placeholder="Pesquisar conversa" />
	</EditForm>

	<div class="flex w-full scrollbar-thin flex-row space-x-6 overflow-x-auto text-sm">
		<div class="rounded-xl border border-white p-1">
			Todos
		</div>
		<div class="rounded-xl border border-white p-1">
			Privados
		</div>
		<div class="rounded-xl border border-white p-1">
			Grupos
		</div>
		<div class="rounded-xl border border-white p-1">
			Arquivados
		</div>
	</div>
</header>


@code {
	private string SearchChat { get; set; } = "";

	private void OpenModal()
	{
		HeaderService.OpenModalCreateChatPrivate();
	}
}
