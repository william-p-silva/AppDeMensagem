

<header class="flex flex-col gap-6">
	<div class="flex justify-between">
		<h1>Conversas</h1>
		<div class="flex gap-6">
			<button>
				💬
			</button>
			<div>
				:
			</div>
		</div>
	</div>

	<EditForm Model="SearchChat" class="flex w-full items-center justify-center rounded-full bg-gray-600 p-2 outline-none">
		🔍
		<InputText @bind-Value="SearchChat"
				   class="w-full rounded-full bg-gray-600 px-2 py-1 outline-none"
				   placeholder="Pesquisar conversa" />
	</EditForm>

	<div class="flex w-full flex-row justify-between text-sm">
		<div class="rounded-xl border border-white p-1">
			Todos
		</div>
		<div class="rounded-xl border border-white p-1">
			Privados
		</div>
		<div class="rounded-xl border border-white p-1">
			Grupos
		</div>
		<div class="rounded-xl border border-white p-1">
			Desativados
		</div>
	</div>
</header>


@code {
	private string SearchChat { get; set; } = "";
}
