@using AppDeMensagem.Feature.User.Model.ViewContato
@using AppDeMensagem.Feature.User.Services.Chat
@inject ChatService ChatService


<div class="flex h-20 cursor-pointer items-center justify-center space-y-6 rounded-2xl bg-gray-800 px-4" @onclick="() => HandleSetChat()">

	<div class="flex w-full items-center justify-start gap-6 p-2">
		<div class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-lg font-bold text-black">
			@(string.IsNullOrWhiteSpace(Chat?.Name) ? "U" : Chat.Name[0].ToString().ToUpper())
		</div>

		<div class="text-sm">
			<p>@(string.IsNullOrWhiteSpace(Chat?.Name) ? "Usuário" : Chat.Name)</p>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public ChatsModel? Chat { get; set; }

	public async Task HandleSetChat()
	{
		if (Chat != null)
		{
			await ChatService.SetChatActive(Chat.Chat_ID);
		}
	}
	
}